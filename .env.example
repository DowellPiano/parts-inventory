# Flask session security. Change this before deploying.
SECRET_KEY=change-this-to-a-long-random-value

# Local SQLite database file. Relative paths live under Flask's instance folder.
INVENTORY_DATABASE_PATH=parts_inventory.db

# Local photo upload folder. Leave as-is for the default tracked app folder.
INVENTORY_UPLOAD_FOLDER=static/uploads

# Maximum upload size for part photos and PO images, in megabytes.
INVENTORY_MAX_UPLOAD_MB=16

# Development server settings for `python3 app.py`.
FLASK_RUN_HOST=localhost
FLASK_RUN_PORT=5001
FLASK_DEBUG=0

# Optional semantic search. Leave disabled for fully local fuzzy search.
SEARCH_EMBEDDINGS_ENABLED=0
SEARCH_EMBEDDINGS_PROVIDER=
SEARCH_EMBEDDINGS_API_KEY=
SEARCH_EMBEDDINGS_MODEL=
